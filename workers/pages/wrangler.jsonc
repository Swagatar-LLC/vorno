// SUV-0060: isolated from the inert-JSON vorno-share Worker by worker name,
// host, R2 bucket, rate-limit namespaces, and password-ticket secret.
//
// Do not deploy until SUV-0063 lands. Retention was approved 2026-09-13 and the
// read-path deadline ships in index.js (SUV-0069), but the other half of that
// promise — an R2 lifecycle rule deleting objects 30 days after upload, and
// 90-day operational log retention — is BUCKET configuration and cannot be
// declared here. See README "Required Cloudflare provisioning"; it is the one
// item with no automated check behind it.
{
  "name": "vorno-pages",
  "main": "index.js",
  "compatibility_date": "2026-09-10",
  "r2_buckets": [
    { "binding": "PAGES", "bucket_name": "vorno-pages" }
  ],
  "ratelimits": [
    {
      "name": "PAGE_CREATE_LIMIT",
      "namespace_id": "REPLACE_WITH_ISOLATED_PAGES_CREATE_NAMESPACE",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "PAGE_PASSWORD_LIMIT",
      "namespace_id": "REPLACE_WITH_ISOLATED_PAGES_PASSWORD_NAMESPACE",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Set only after the benchmark is rerun in the intended Workers plan/runtime.
    "PBKDF2_ITERATIONS": "100000"
  },
  "routes": [{ "pattern": "pages.vorno.ai", "custom_domain": true }]
}
