// SUV-0060: isolated from the inert-JSON vorno-share Worker by worker name,
// host, R2 bucket, rate-limit namespaces, and password-ticket secret.
// Deploy gate discharged 2026-09-13: SUV-0063 landed (vorno-site a829555) and
// Jeff approved privacy + retention explicitly. Rate-limit namespace ids are
// self-assigned per Worker (not provisioned resources); 2001/2002 leave the
// 1001-block free for vorno-share, which does not yet exist on the account.
{
  "name": "vorno-pages",
  "main": "index.js",
  "compatibility_date": "2026-09-10",
  "r2_buckets": [
    { "binding": "PAGES", "bucket_name": "vorno-pages" }
  ],
  "ratelimits": [
    {
      "name": "PAGE_CREATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "PAGE_PASSWORD_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Set only after the benchmark is rerun in the intended Workers plan/runtime.
    "PBKDF2_ITERATIONS": "100000"
  },
  "routes": [{ "pattern": "pages.vorno.ai", "custom_domain": true }]
}
